node_modules
dist
.vercel
*.log
# 배포물과 무관한 원본/보관 파일
/*.glb
/archive/
# 비밀 키(EmailJS 등). 형식 예시인 .env.example만 올린다
.env
.env.*
!.env.example
# INTRO·HOME 원본 영상(용량). 시퀀스는 npm run build:intro / build:home으로 만든다
/public/media/intro/raw/
/public/media/home/raw/*
!/public/media/home/raw/README.md
# 480p 테스트 시퀀스와 그 manifest는 올리지 않는다. 720p 최종 시퀀스가 나오면 두 줄을 지우고 함께 올린다
# (manifest만 올라가고 시퀀스가 없으면 배포된 INTRO가 빈 화면이 된다)
/public/media/intro/seq/
/public/media/intro/manifest.json
/public/media/home/seq/
/public/media/home/manifest.json

# 111MB 원본(GitHub 100MB 제한 초과). 화면에서는 public/models/home/web/pen-web.obj(웹용 사본)를 쓴다
/public/models/home/PEN1.obj
